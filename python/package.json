{
  "name": "@scellop/widget",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run build -- --sourcemap=inline --watch",
    "build": "pnpm exec esbuild js/widget.tsx --minify --format=esm --bundle --outdir=src/scellop/static --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anywidget/react": "^0.0.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@scellop/data-loading": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scellop": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.2"
  }
}
