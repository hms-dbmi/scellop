{
  "name": "scellop",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Thomas Smits",
  "description": "Scalable visualization for single-cell data - interactive heatmaps with metadata",
  "homepage": "https://github.com/hms-dbmi/scellop#readme",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hms-dbmi/scellop.git",
    "directory": "packages/scellop"
  },
  "keywords": [
    "visualization",
    "single-cell",
    "heatmap",
    "react",
    "scRNA-seq",
    "cell-types"
  ],
  "bugs": {
    "url": "https://github.com/hms-dbmi/scellop/issues"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "bench:data": "vitest bench --config vitest.bench.config.ts data-processing",
    "bench:render": "vitest bench --config vitest.bench.config.ts heatmap-rendering",
    "bench:graphs": "vitest bench --config vitest.bench.config.ts side-graphs",
    "bench:export": "vitest bench --config vitest.bench.config.ts export",
    "bench:stats": "tsx scripts/show-dataset-stats.ts",
    "bench:stats:json": "tsx scripts/show-dataset-stats.ts --json",
    "bench:add-metadata": "tsx scripts/add-metadata-to-results.ts benchmark-results.json",
    "bench:report": "tsx scripts/generate-performance-report.ts",
    "bench": "vitest bench --config vitest.bench.config.ts --outputJson=benchmark-results.json && npm run bench:add-metadata && npm run bench:report",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@scellop/data-loading": "workspace:*",
    "@visx/axis": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/text": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "d3": "^7.9.0",
    "proxy-memoize": "^3.0.1",
    "zundo": "^2.3.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "zustand": "^4 || ^5"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.0.16",
    "jsdom": "^30.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.0.16",
    "zustand": "^5.0.3"
  }
}
